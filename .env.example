# Runtime
NODE_ENV=development
APP_NAME=NESGESFinanceTrust
APP_VERSION=3.4.0-dev
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
API_PREFIX=/api

# Bitcoin data source: core | esplora
MEMPOOL_NETWORK=mainnet
MEMPOOL_BACKEND=esplora
ESPLORA_REST_API_URL=https://blockstream.info/api
CORE_RPC_HOST=127.0.0.1
CORE_RPC_PORT=8332
CORE_RPC_USERNAME=nesges_rpc
CORE_RPC_PASSWORD=
CORE_RPC_TIMEOUT=60000

# Persistence
DATABASE_ENABLED=true
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=nesgesfinance
DATABASE_USERNAME=nesges
DATABASE_PASSWORD=change-me
DATABASE_POOL_SIZE=10
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Feature and compliance controls
RUNES_INDEXING_ENABLED=true
ORDINALS_INDEXING_ENABLED=true
RWA_REGISTRY_ENABLED=true
COMPLIANCE_KYC_REQUIRED=true
COMPLIANCE_AML_PROVIDER=interno
COMPLIANCE_MICA_JURISDICTION=EU
